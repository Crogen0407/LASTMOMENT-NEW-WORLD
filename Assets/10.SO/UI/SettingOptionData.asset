  uiDescriptionDictionary:
    _serializedList:
    - Key: 0
      Value: "\uC0B6\uC758 \uBC29\uD5A5\uC740 \uB0A8\uC774 \uC544\uB2CC \uC790\uC2E0\uC774
        \uC815\uD558\uB294 \uAC70\uC57C, \uBB3C\uB860 \uCC45\uC784 \uB610\uD55C \uBCF8\uC778
        \uBAAB\uC774\uC9C0"
    - Key: 1
      Value: "\uB09C \uB108\uC758 \uAC10\uC744 \uBBFF\uC5B4"
    - Key: 2
      Value: "\uAE30\uACC4\uC74C\uC744 \uC88B\uC544\uB294 \uAD34\uC9DC\uB4E4\uB3C4
        \uC788\uC9C0\uB9CC \uD30C\uC77C\uB7FF\uB4E4\uC5D0\uAC8C\uB294 \uCE60\uD310\uC744
        \uAE01\uB294 \uC18C\uB9AC\uBCF4\uB2E4 \uB354 \uB054\uCC0D\uD55C \uC18C\uB9AC\uC57C"
    - Key: 3
      Value: "\uC5B4\uB514\uC11C \uB4E4\uB824\uC624\uB294\uC9C0 \uBAA8\uB974\uB294
        \uC774\uC0C1\uD55C \uC74C\uC545 \uC18C\uB9AC\uAC00 \uC2E0\uACBD \uC4F0\uC778\uB2E4\uBA74
        \uD574\uB2F9 \uC635\uC158\uC744 \uC870\uC808\uD574\uBCF4\uB3C4\uB85D \uD558\uB834"
    - Key: 4
      Value: "\uD3ED\uBC1C\uC74C\uC740 \uACE0\uB9C9\uC774 \uCC22\uC5B4\uC9C8 \uC815\uB3C4\uB85C
        \uC694\uB780\uD55C \uC18C\uB9AC\uC774\uB2C8 \uC8FC\uC758\uD558\uB294 \uAC8C
        \uC88B\uC744 \uAC70\uC57C"
    - Key: 5
      Value: "\uB208\uC5D0 \uBCF4\uC774\uB294 \uAC83\uB3C4 \uC88B\uC9C0\uB9CC \uB0B4\uBA74\uB3C4
        \uADF8\uB9CC\uD07C \uC911\uC694\uD558\uB2E4 \uC0DD\uAC01\uD574"
    - Key: 6
      Value: "\uC61B\uB0A0 \uBA85\uC791 \uC560\uB2C8\uBA54\uC774\uC158\uC744 \uBCF4\uACE0
        \uC2F6\uC5B4\uB3C4 \uBCF4\uC9C0 \uBABB\uD558\uB294 \uC774\uC720\uC57C"
    - Key: 7
      Value: "\uC791\uC740 \uAC83\uB4E4\uC774 \uC788\uC5B4\uC57C \uD070 \uAC83\uB4E4\uB3C4
        \uC788\uC744 \uC218 \uC788\uB294 \uBC95\uC774\uC9C0"
